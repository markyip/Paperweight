{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paperweight",
  "version": "0.1.1",
  "identifier": "com.paperweight.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Paperweight",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "dragDropEnabled": true,
        "theme": "Dark",
        "backgroundColor": "#111113"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob: 'wasm-unsafe-eval'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "shortDescription": "Lightweight PDF / EPUB reader",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "name": "Paperweight.PDF",
        "ext": ["pdf"],
        "mimeType": "application/pdf",
        "description": "PDF Document",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "Paperweight.EPUB",
        "ext": ["epub"],
        "mimeType": "application/epub+zip",
        "description": "EPUB Document",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "windows/header.bmp",
        "sidebarImage": "windows/sidebar.bmp",
        "uninstallerHeaderImage": "windows/header.bmp",
        "installerHooks": "windows/installer-hooks.nsh",
        "languages": ["English", "TradChinese"]
      }
    }
  }
}
